# Multi-Platform Friend Status MCP Server
# Copy this file to .env and fill in your API credentials

# Discord API Configuration
# Get your bot token from: https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Steam API Configuration
# Get your API key from: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=your_steam_api_key_here

# Riot Games API Configuration
# Get your API key from: https://developer.riotgames.com/
RIOT_API_KEY=your_riot_api_key_here

# Server Configuration
PORT=8000
ENVIRONMENT=production
